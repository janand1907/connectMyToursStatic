# Copy this file to .env.local and fill in real values.
# Used by app/api/enquiry/route.js to email enquiries to MAIL_TO.
# See EMAIL_SETUP.md for the full setup, testing, and deployment guide.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_TO=connectmytours@gmail.com

# Blog Phase 1: LOCAL database only. Never use production credentials here.
# Copy placeholders into your private .env.local; do not commit real values.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=connect_my_tours_blog_local
MYSQL_USER=replace_with_local_blog_user
MYSQL_PASSWORD=replace_with_local_database_password
APP_ORIGIN=http://localhost:3000
SESSION_SECRET=replace_with_at_least_32_random_bytes
# Local development only. Production persistent storage is not yet approved.
BLOG_UPLOAD_DIR=.local/blog-uploads
BLOG_UPLOAD_MAX_BYTES=5242880
